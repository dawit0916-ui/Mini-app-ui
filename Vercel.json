{
  "rewrites": [
    {
      "source": "/((?!fallback\\.html).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(curl|wget|httpie|python|axios|node-fetch|go-http|postman|insomnia|libwww|java|okhttp|scrapy|spider|crawl|bot).*"
        }
      ],
      "destination": "/fallback.html"
    }
  ]
}
